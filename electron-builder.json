{
  "productName": "Video Hub App 3",
  "appId": "com.videohubapp.videohubapp3",
  "copyright": "Copyright © 2025 Boris Yakubchik",
  "directories": {
    "output": "release/"
  },
  "asar": true,
  "asarUnpack": [
    "**/node_modules/ffmpeg-static/**",
    "**/node_modules/@ffprobe-installer/**"
  ],
  "files": [
    "**/*",
    "!**/*.ts",
    "!LICENSE.md",
    "!package.json",
    "!package-lock.json",
    "!src/",
    "!angular.json",
    "!tsconfig.json",
    "!tslint.json"
  ],
  "extraResources": [
    {
      "from": "src/assets/icons/mac/touch-bar",
      "to": "assets"
    },
    {
      "from": "remote",
      "to": "remote"
    },
    {
      "from": "src/assets/logo.png",
      "to": "assets/logo.png"
    }
  ],
  "win": {
    "icon": "src/favicon.ico",
    "signAndEditExecutable": true,
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg.exe",
        "to": "bin/ffmpeg.exe"
      },
      {
        "from": "node_modules/@ffprobe-installer/win32-${arch}/ffprobe.exe",
        "to": "bin/ffprobe.exe"
      }
    ],
    "target": [
      "nsis",
      "portable"
    ]
  },
  "mac": {
    "category": "public.app-category.video",
    "target": {
      "target": "dmg",
      "arch": [
        "x64",
        "arm64"
      ]
    },
    "icon": "src/assets/icons.icns",
    "asar": true,
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg",
        "to": "bin/ffmpeg"
      },
      {
        "from": "node_modules/@ffprobe-installer/darwin-${arch}/ffprobe",
        "to": "bin/ffprobe"
      }
    ]
  },
  "linux": {
    "icon": "src/assets/icons.icns",
    "extraResources": [
      {
        "from": "node_modules/ffmpeg-static/ffmpeg",
        "to": "bin/ffmpeg"
      },
      {
        "from": "node_modules/@ffprobe-installer/linux-${arch}/ffprobe",
        "to": "bin/ffprobe"
      }
    ],
    "target": [
      "AppImage"
    ]
  },
  "nsis": {
    "installerIcon": "src/favicon.ico",
    "uninstallerIcon": "src/favicon.ico",
    "installerHeaderIcon": "src/favicon.ico",
    "oneClick": false,
    "perMachine": true
  },
  "fileAssociations": {
    "ext": "vha2",
    "name": "Video Hub App 3 file",
    "role": "Editor"
  }
}
